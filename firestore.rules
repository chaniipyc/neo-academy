rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // 로그인만 되어 있는 게 아니라, 관리자가 실제로 발급한 계정(= users 문서가 있는 계정)인지 확인.
    // Firebase 프로젝트 설정 값은 공개돼도 안전하도록 설계돼 있어서, 이메일/비밀번호 로그인이
    // 켜져 있으면 누구나 스스로 새 계정을 만들 수 있음 — 그런 "자기가 만든" 계정은 users 문서가
    // 없으므로 여기서 걸러짐.
    function hasIssuedAccount() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    // 학생 정보: 관리자가 발급한 계정만 읽고 쓸 수 있음
    match /students/{studentId} {
      allow read, write: if hasIssuedAccount();
    }

    // 반/출결/시험 정보: 관리자가 발급한 계정만 읽고 쓸 수 있음
    match /classes/{classId} {
      allow read, write: if hasIssuedAccount();
    }

    // 입반 테스트 명단/점수: 관리자가 발급한 계정만 읽고 쓸 수 있음
    match /admissions/{docId} {
      allow read, write: if hasIssuedAccount();
    }

    // 계정 role 정보: 본인 문서는 누구나 읽기 가능(로그인 상태 확인용),
    // 그 외 문서는 관리자만 읽기 가능. 쓰기(계정 생성/삭제)는 관리자만 가능.
    match /users/{uid} {
      allow read: if isSignedIn() && (request.auth.uid == uid || isAdmin());
      allow write: if isAdmin();
    }

    // 로그인 ID → 실제 인증용 이메일 매핑. 로그인하기 "전"에 조회해야 하므로
    // 로그인 없이도 읽을 수 있어야 함(비밀번호는 여기 없고, 이메일 자체도
    // 실제 이메일이 아닌 내부용 값이라 공개돼도 큰 문제는 없음). 쓰기는 관리자만.
    match /usernames/{loginId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
